# ---------------------------------------------------------------------------
# Google Vertex AI (required for resume parsing, JD generation, job matching)
# ---------------------------------------------------------------------------
# Project ID for Generative AI on Vertex
GCP_PROJECT_ID=your-gcp-project-id
# Optional; default used by ChatVertexAI if unset
GCP_LOCATION=us-central1

# Application Default Credentials (default): clears any service-account
# GOOGLE_APPLICATION_CREDENTIALS, then pins user ADC via GCP_ADC_CREDENTIALS_PATH when set;
# otherwise google.auth.default() uses standard ADC paths (e.g. Windows %APPDATA%\gcloud\...).
GCP_USE_ADC_ONLY=true
# Set to true only if you must use a service account JSON (CI / server); also set GCP_USE_ADC_ONLY=false.
GCP_ALLOW_SERVICE_ACCOUNT_KEY=false
# Optional: explicit ADC JSON path (Windows default is also scanned: %APPDATA%\gcloud\application_default_credentials.json)
# GCP_ADC_CREDENTIALS_PATH=c:\Users\YOUR_USER\AppData\Roaming\gcloud\application_default_credentials.json

# Auth — pick ONE approach:
#
# A) ADC (default): do not set GOOGLE_APPLICATION_CREDENTIALS to a service account.
#    Optional: GCP_ADC_CREDENTIALS_PATH=...\application_default_credentials.json
#    gcloud auth application-default login
#    Windows ADC: %APPDATA%\gcloud\application_default_credentials.json
#
# B) Service account key file (opt-in):
#    GCP_USE_ADC_ONLY=false
#    GCP_ALLOW_SERVICE_ACCOUNT_KEY=true
#    GOOGLE_APPLICATION_CREDENTIALS=d:\path\to\service-account.json
#
# Primary Gemini model ID on Vertex (examples: gemini-2.5-pro, gemini-2.5-flash)
LLM_PROVIDER=vertexai
LLM_MODEL=gemini-2.5-pro
LLM_MODEL_NAME=gemini-2.5-pro
LLM_FALLBACK_MODEL=gemini-2.5-pro
LLM_FAST_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Vertex AI uses Application Default Credentials (ADC), NOT GEMINI_API_KEY.
# Keys below are only for the standalone Generative Language API or legacy tests.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Fallback Google API key (only needed if different from GEMINI_API_KEY)
# GOOGLE_API_KEY=your_google_api_key_here

# LangSmith Configuration (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=quanthire-ai
LANGCHAIN_TRACING_V2=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/quanthire

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ---------------------------------------------------------------------------
# Azure Non-Prod replatform (real platform values — copy output/azure_deployment/env/azure-nonprod.env)
# ---------------------------------------------------------------------------
# DEPLOYMENT_TARGET=azure-nonprod
# AUTH_MODE=basic
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://aif-ail-npd-we-01.openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# POSTGRES_HOST=psql-ail-npd-we-01.postgres.database.azure.com
# POSTGRES_DB=quanthire_ai
# AZURE_STORAGE_ACCOUNT_NAME=dlsailnpdqc01
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://di-ail-npd-we-01.cognitiveservices.azure.com/
# VECTOR_STORE=pgvector
# MILVUS_ENABLED=false
