# LangGraph Studio Environment Variables
# Copy this to .env and fill in your actual values

# LangSmith API Key (from https://smith.langchain.com)
LANGCHAIN_API_KEY=your_langsmith_api_key

# LangSmith Project Name
LANGCHAIN_PROJECT=quanthire-ai

# Enable LangChain Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Primary LLM Configuration - Vertex AI (ADC only)
LLM_MODEL=gemini-2.5-pro
LLM_MODEL_NAME=gemini-2.5-pro
LLM_PROVIDER=vertexai
LLM_FALLBACK_MODEL=gemini-2.5-pro

# Google Vertex AI Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_USE_ADC_ONLY=true
GCP_ALLOW_SERVICE_ACCOUNT_KEY=false
GCP_ADC_CREDENTIALS_PATH=c:\Users\YOUR_USER\AppData\Roaming\gcloud\application_default_credentials.json

# LLM Configuration
LLM_TEMPERATURE=0.5

# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Application Environment
ENVIRONMENT=development
DEBUG=true
