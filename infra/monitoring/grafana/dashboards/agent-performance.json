{
  "dashboard": {
    "title": "QuantHireAI - Agent Performance",
    "tags": ["quanthire", "agents", "ml"],
    "timezone": "browser",
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Agent Execution Time (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(agent_execution_duration_seconds_bucket[5m]))",
            "legendFormat": "{{agent_name}} P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "seconds", "show": true},
          {"show": false}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [2.0], "type": "gt"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"type": "avg"},
              "type": "query"
            }
          ],
          "name": "Slow Agent Response"
        }
      },
      {
        "id": 2,
        "title": "Agent Success Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(agent_executions_total{result=\"success\"}[5m]) / rate(agent_executions_total[5m])",
            "legendFormat": "{{agent_name}} Success Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "success rate", "format": "percentunit", "show": true}
        ]
      },
      {
        "id": 3,
        "title": "Agent Confidence Scores",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "avg by (agent_name) (agent_confidence_score)",
            "legendFormat": "{{agent_name}} Avg Confidence",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Agent Request Volume",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(agent_executions_total[5m])",
            "legendFormat": "{{agent_name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "ParsingAgent Accuracy",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "avg(agent_parsing_accuracy)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.85, "color": "yellow"},
                {"value": 0.95, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "DecisionAgent Bias Check Pass Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
        "targets": [
          {
            "expr": "sum(agent_bias_check_passed) / sum(agent_bias_checks_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.99, "color": "yellow"},
                {"value": 1.0, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Human Override Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(agent_human_overrides_total) / sum(agent_executions_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 8,
        "title": "Agent Queue Depth",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
        "targets": [
          {
            "expr": "celery_queue_length",
            "refId": "A"
          }
        ]
      }
    ]
  }
}












