{
  "dashboard": {
    "title": "QuantHireAI - Hiring KPIs",
    "tags": ["quanthire", "kpis", "hiring"],
    "timezone": "browser",
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "title": "Time to Hire (Days)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "avg(hiring_time_to_hire_days)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "d",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 30, "color": "yellow"},
                {"value": 45, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Applications This Month",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(applications_total[30d]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Offers Accepted Rate",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(offers_accepted_total) / sum(offers_sent_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.85, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Active Jobs",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(jobs_active_total)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Hiring Funnel",
        "type": "bargauge",
        "gridPos": {"h": 12, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "applications_total",
            "legendFormat": "Applications",
            "refId": "A"
          },
          {
            "expr": "candidates_screened_total",
            "legendFormat": "Screened",
            "refId": "B"
          },
          {
            "expr": "candidates_interviewed_total",
            "legendFormat": "Interviewed",
            "refId": "C"
          },
          {
            "expr": "offers_sent_total",
            "legendFormat": "Offers Sent",
            "refId": "D"
          },
          {
            "expr": "offers_accepted_total",
            "legendFormat": "Hires",
            "refId": "E"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 6,
        "title": "Time to Hire Trend",
        "type": "graph",
        "gridPos": {"h": 12, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "avg(hiring_time_to_hire_days)",
            "legendFormat": "Avg Time to Hire",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "days", "show": true}
        ]
      },
      {
        "id": 7,
        "title": "Source Effectiveness",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "sum by (source) (applications_total)",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Department Hiring Activity",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "targets": [
          {
            "expr": "sum by (department) (jobs_active_total)",
            "legendFormat": "{{department}}",
            "refId": "A"
          }
        ]
      }
    ]
  }
}












