{
  "dashboard": {
    "title": "QuantHireAI - LLM Costs & Usage",
    "tags": ["quanthire", "llm", "costs"],
    "timezone": "browser",
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Daily LLM Budget Utilization",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "(llm_daily_cost_usd / llm_daily_budget_usd) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 80, "color": "yellow"},
                {"value": 95, "color": "red"}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 2,
        "title": "LLM Cost by Agent (Today)",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "sum by (agent_name) (llm_cost_usd_total)",
            "legendFormat": "{{agent_name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Token Usage by Agent",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "sum by (agent_name) (llm_tokens_total)",
            "legendFormat": "{{agent_name}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 4,
        "title": "LLM Cost Trend (7 days)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_cost_usd_total[1h])) * 24",
            "legendFormat": "Daily Cost Projection",
            "refId": "A"
          },
          {
            "expr": "llm_daily_budget_usd",
            "legendFormat": "Budget",
            "refId": "B"
          }
        ]
      },
      {
        "id": 5,
        "title": "Model Usage Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum by (model) (llm_requests_total)",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Average Cost per Request",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(llm_cost_usd_total) / sum(llm_requests_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 4
          }
        }
      }
    ]
  }
}












